<%# pulsante di eliminazione con conferma: url (POST), conferma (testo), etichetta (default "Elimina") %>
<form method="post" action="<%= url %>" style="display:inline" onsubmit="return confirm(<%= JSON.stringify(conferma) %>)"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sec danger"><%= typeof etichetta !== 'undefined' ? etichetta : 'Elimina' %></button></form>
