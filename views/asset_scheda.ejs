<%- include('_head', {titolo: nomeAsset(a)}) %>
<p class="mut" style="margin:0 0 8px"><a href="<%= a.fuori ? '/cestino' : '/asset' %>">← <%= a.fuori ? 'Cestino' : 'Tutti gli asset' %></a></p>
<% if (a.fuori) { %><div class="banner-cestino"><span>🗑 <b>Nel Cestino</b>: <%= a.stato %><%= a.data_dismissione ? ' il ' + data(a.data_dismissione) : '' %>. Non è più in contabilità; qui resta la traccia.</span>
  <form method="post" action="/asset/<%= a.id %>/ripristina" onsubmit="return confirm('Ripristinare questo asset? Torna in magazzino con stato Disponibile.')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sec sm">Ripristina</button></form></div><% } %>
<div class="card">
  <div class="scheda">
    <span class="tondo"><%- include('_icon', {tipo: a.tipologia, dim: 28}) %></span>
    <div style="flex:1;min-width:200px"><h1><%= [a.marca, a.modello].filter(Boolean).join(' ') || a.tipologia %></h1>
      <div class="mut"><%= [cesp(a.cespite), a.tipologia, a.azienda].filter(Boolean).join(' · ') %></div></div>
    <%- include('_badge', {stato: a.stato}) %>
    <a class="btn" href="/asset/<%= a.id %>/modifica">Modifica</a>
    <%- include('_elimina', {url: '/asset/' + a.id + '/elimina', conferma: 'Eliminare definitivamente questo asset (' + ([a.marca, a.modello].filter(Boolean).join(' ') || a.tipologia) + ')? Si cancellano anche il suo storico movimenti; le SIM montate restano ma non sono più su un telefono. Non si può annullare. Se il dispositivo è solo dismesso, meglio cambiargli lo stato.'}) %>
  </div>
  <% if (a.assegnato_a) { %><div class="chi" style="display:flex;align-items:center;gap:10px;margin-top:16px"><%- include('_avatar', {nome: a.assegnato_a}) %><span>Assegnato a <b><%= a.assegnato_a %></b></span></div><% } %>
</div>

<div class="grid g2">
  <section class="card"><h2>Dispositivo</h2><div class="fatti">
    <% if (av) { %><div><span>Antivirus</span><b><%- include('_av', {stato: av.antivirus, visto: av.ultimo_rilevato}) %> <%= av.antivirus === 'OK' ? 'Attivo' : av.antivirus === 'Da verificare' ? 'Da verificare' : 'Non presente nel report' %><%= av.ultimo_rilevato ? ' · visto il ' + data(av.ultimo_rilevato) : '' %></b></div><% } %>
    <% [['Sistema operativo', a.sistema_operativo], ['RAM', a.ram_gb ? a.ram_gb + ' GB' : ''], ['Storage', a.storage_gb ? a.storage_gb + ' GB' : ''], ['Serial', a.serial], ['Hostname', a.hostname]].forEach(([k, v]) => { if (v) { %>
      <div><span><%= k %></span><b><%= v %></b></div><% } }) %>
  </div></section>
  <section class="card"><h2>Acquisto</h2><div class="fatti">
    <% [['Fornitore', a.fornitore], ['Fattura', a.n_fattura], ['Data acquisto', data(a.data_acquisto)], ['Importo', euro(a.importo)], ['Dismesso il', data(a.data_dismissione)]].forEach(([k, v]) => { if (v) { %>
      <div><span><%= k %></span><b><%= v %></b></div><% } }) %>
  </div></section>
</div>
<% if (a.note) { %><section class="card"><h2>Note</h2><div style="white-space:pre-wrap"><%= a.note %></div></section><% } %>
<% if (sim.length || ['Telefono', 'Tablet'].includes(a.tipologia)) { %><section class="card"><h2>SIM <a class="btn sec sm dx" href="/sim/nuova?asset_id=<%= a.id %>">+ Aggiungi SIM</a></h2>
  <% if (!sim.length) { %><div class="mut">Nessuna SIM in questo dispositivo.</div><% } %>
  <% sim.forEach(s => { %><div class="simbox">
    <div class="testa-sim"><span class="tondo"><%- include('_icon', {tipo: 'SIM'}) %></span><span class="num"><%= s.numero || 'senza numero' %></span><%- include('_badge', {stato: s.stato}) %><a class="btn sec sm dx" href="/sim/<%= s.id %>/modifica">Modifica</a></div>
    <div class="fatti">
    <% [['Operatore', s.operatore], ['Piano', s.piano], ['Costo mensile', s.costo_mensile ? euro(s.costo_mensile) : ''], ['Giga del telefono', s.giga_telefono],
        ['Intestata a', s.persona && s.persona !== a.assegnato_a ? s.persona : ''], ['Saponetta', s.saponetta === null ? '' : (s.saponetta ? 'Sì' : 'No') + (s.giga_saponetta ? ' · ' + s.giga_saponetta : '')]].forEach(([k, v]) => { if (v) { %>
      <div><span><%= k %></span><b><%= v %></b></div><% } }) %>
    </div><% if (s.note) { %><div class="mut" style="margin-top:10px;white-space:pre-wrap"><%= s.note %></div><% } %>
  </div><% }) %>
</section><% } %>

<section class="card"><h2>Storico</h2>
  <% if (!mov.length) { %><div class="mut">Nessun movimento registrato.</div><% } %>
  <ul class="storia">
  <% mov.forEach(m => { %>
    <li><span class="pt"></span><div><span class="t"><%= m.tipo %></span> <span class="mut">· <%= data(m.data) %></span>
      <div class="s"><% if (m.da || m.a) { %><%= m.da || '—' %> → <%= m.a || '—' %><% } %><% if (m.stato_prima || m.stato_dopo) { %><%= (m.da || m.a) ? ' · ' : '' %><%= m.stato_prima || '—' %> → <%= m.stato_dopo || '—' %><% } %></div>
      <% if (m.note) { %><div class="s"><%= m.note %></div><% } %></div></li>
  <% }) %>
  </ul>
  <form method="post" action="/movimenti" class="filtri" style="margin:14px 0 0">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="asset_id" value="<%= a.id %>">
    <label>Data<input type="date" name="data"></label><label class="cerca">Aggiungi una nota<input name="note" required></label><button class="sec">Aggiungi</button>
  </form>
</section>
<%- include('_foot') %>
