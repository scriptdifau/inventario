<%# intestazione cliccabile: griglia (classe della riga), colonne [{k, label, cls}] (k vuoto = cella senza ordinamento), ord corrente %>
<div class="testa <%= griglia %>">
<% colonne.forEach(c => { if (!c.k) { %><span></span><% } else { const attiva = ord.chiave === c.k; %>
  <a class="<%= c.cls || '' %> <%= attiva ? 'on' : '' %>" href="<%= urlCon({ord: c.k, dir: attiva && ord.dir === 'asc' ? 'desc' : 'asc'}) %>" title="Ordina per <%= c.label %>"><%= c.label %><% if (attiva) { %> <b><%= ord.dir === 'asc' ? '▲' : '▼' %></b><% } %></a>
<% } }) %>
</div>
