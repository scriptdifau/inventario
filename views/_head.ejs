<!doctype html>
<html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= typeof titolo !== 'undefined' ? titolo + ' · ' : '' %>Inventario IT</title>
<link rel="stylesheet" href="/static/style.css"></head><body>
<nav>
  <% [['/','Dashboard'],['/asset','Asset'],['/persone','Persone'],['/sim','SIM'],['/movimenti','Movimenti'],['/antivirus','Antivirus']].forEach(([h,l]) => { %>
    <a href="<%= h %>" class="<%= (h === '/' ? path === '/' : path.startsWith(h)) ? 'on' : '' %>"><%= l %></a>
  <% }) %>
  <span class="sp"></span><span style="color:var(--mut)"><%= utente.email %></span>
  <form method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="sec">Esci</button></form>
</nav><main>
<% if (errore) { %><div class="err"><%= errore %></div><% } %>
