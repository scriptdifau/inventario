<!doctype html>
<html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= typeof titolo !== 'undefined' ? titolo + ' · ' : '' %>Inventario IT</title>
<link rel="stylesheet" href="/static/style.css?v=3"></head><body>
<header class="top"><div class="in">
  <a class="brand" href="/">Inventario <b>IT</b></a>
  <nav class="links">
  <% [['/','Dashboard'],['/asset','Asset'],['/persone','Persone'],['/sim','SIM'],['/movimenti','Movimenti'],['/antivirus','Antivirus'],['/cespiti','Cespiti ante 2018'],['/importa','Importa']].forEach(([h,l]) => { %>
    <a href="<%= h %>" class="<%= (h === '/' ? path === '/' : path.startsWith(h)) ? 'on' : '' %>"><%= l %></a>
  <% }) %>
  </nav>
  <div class="utente"><span class="mail"><%= utente.email %></span>
    <form method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="sec sm btn">Esci</button></form></div>
</div></header><main>
<% if (errore) { %><div class="err"><%= errore %></div><% } %>
