<%- include('_head', {titolo: 'Asset'}) %>
<% const qs = (extra) => { const p = new URLSearchParams(); Object.entries({ ...filtri, ...extra }).forEach(([k, v]) => { if (v) p.set(k, v); }); const t = p.toString(); return '/asset' + (t ? '?' + t : ''); }; %>
<div class="titolo"><h1>Asset</h1><span class="mut"><%= righe.length %> risultati</span><span class="sp"></span>
  <a class="btn sec sm" href="<%= xlsUrl %>">⬇ Scarica Excel</a><a class="btn sm" href="/asset/nuovo">+ Nuovo asset</a></div>

<div class="chips">
  <a class="chip <%= !filtri.stato ? 'on' : '' %>" href="<%= qs({stato: ''}) %>">Tutti</a>
  <% stati.forEach(st => { if (conteggi[st]) { %><a class="chip <%= filtri.stato === st ? 'on' : '' %>" href="<%= qs({stato: st}) %>"><%= st %> <span class="c"><%= conteggi[st] %></span></a><% } }) %>
</div>

<form class="filtri" method="get">
  <label class="cerca">Cerca<input name="q" value="<%= filtri.q %>" placeholder="codice, persona, modello, serial, hostname…"></label>
  <input type="hidden" name="stato" value="<%= filtri.stato %>">
  <%- include('_sel', {nome:'tipologia', label:'Tipologia', opzioni: tipologie.map(t=>({v:t,l:t})), valore: filtri.tipologia, vuoto:true}) %>
  <%- include('_sel', {nome:'azienda', label:'Azienda', opzioni: aziende.map(a=>({v:a.nome,l:a.nome})), valore: filtri.azienda, vuoto:true}) %>
  <label style="flex-direction:row;align-items:center;gap:6px;padding-bottom:9px"><input type="checkbox" name="uscita" value="1" <%= filtri.uscita ? 'checked' : '' %>> anche usciti</label>
  <button>Filtra</button>
  <% if (filtri.q || filtri.tipologia || filtri.azienda || filtri.uscita || filtri.stato) { %><a class="btn sec" href="/asset">Azzera</a><% } %>
</form>

<div class="righe">
<% if (!righe.length) { %><div class="vuoto">Nessun asset con questi filtri.</div><% } %>
<% righe.forEach(r => { %>
  <a class="riga r-asset" href="/asset/<%= r.id %>">
    <span class="tondo"><%- include('_icon', {tipo: r.tipologia}) %></span>
    <span><span class="t"><%= [r.marca, r.modello].filter(Boolean).join(' ') || r.tipologia %></span><br><span class="s"><%= r.codice %> · <%= r.tipologia %><%= r.hostname ? ' · ' + r.hostname : '' %></span></span>
    <span class="chi"><% if (r.assegnato_a) { %><%- include('_avatar', {nome: r.assegnato_a}) %><span class="nome"><%= r.assegnato_a %></span><% } else { %><span class="mut">—</span><% } %></span>
    <span><%- include('_badge', {stato: r.stato}) %></span>
    <span class="s"><%= r.azienda %></span>
    <span class="n"><%= euro(r.importo) %></span>
  </a>
<% }) %>
</div>
<%- include('_foot') %>
