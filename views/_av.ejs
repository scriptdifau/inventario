<%# simbolo antivirus: stato = 'OK' | 'Da verificare' | 'Mancante'; visto = data dell'ultimo rilevamento (facoltativa) %>
<% const v = typeof visto !== 'undefined' && visto ? data(visto) : '';
   const k = stato === 'OK' ? ['av-ok', 'Antivirus attivo e aggiornato' + (v ? ' (visto il ' + v + ')' : '')]
     : stato === 'Da verificare' ? ['av-dv', 'Antivirus nel report ma da verificare' + (v ? ': ultimo rilevamento il ' + v : '')]
     : ['av-no', 'Nessun antivirus nel report']; %><span class="av-ico <%= k[0] %>" title="<%= k[1] %>" aria-label="<%= k[1] %>"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<% if (stato === 'OK') { %><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>
<% } else if (stato === 'Da verificare') { %><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M12 8v4M12 15.5h.01"/>
<% } else { %><path d="M19 11V6l-7-3-2.6 1.1M5 6v5c0 4.5 3 8 7 10 1.4-.7 2.6-1.6 3.6-2.7"/><path d="M3 3l18 18"/><% } %></svg></span>
