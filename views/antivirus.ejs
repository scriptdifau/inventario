<%- include('_head', {titolo: 'Antivirus'}) %>
<%- include('_briciole') %>
<div class="titolo"><h1><%= ctx ? ctx.titolo : 'Controllo antivirus' %></h1><span class="sp"></span><a class="btn sec sm" href="<%= xlsUrl %>">⬇ Scarica Excel</a><a class="btn sm" href="/importa">Carica nuovo report</a></div>
<%- include('_schede') %>
<p class="sottotitolo">Ultimo report: <%= ultimo ? data(ultimo.importato) + ' (' + ultimo.file_nome + ')' : 'nessuno' %> · ogni PC e server Windows attivo deve comparire.</p>
<% const n = (v) => righe.filter(r => r.antivirus === v).length; %>
<div class="stat" style="margin-bottom:16px">
  <div><b class="ok"><%= n('OK') %></b><span>protetti e aggiornati</span></div>
  <div><b class="warn"><%= n('Da verificare') %></b><span>da verificare (fermi da più di 20 giorni)</span></div>
  <div><b class="bad"><%= n('Mancante') %></b><span>assenti dal report</span></div>
</div>
<%- include('_ordsel') %>
<%- include('_testa', {griglia: 'r-av', colonne: [{k: 'esito', label: 'Esito'}, {k: 'asset', label: 'Asset'}, {k: 'persona', label: 'Persona'}, {k: 'report', label: 'Nel report'}, {k: 'visto', label: 'Ultimo rilevato', cls: 'n'}]}) %>
<div class="righe">
<% righe.forEach(r => { %>
  <a class="riga r-av" href="/asset?q=<%= r.codice %>">
    <span><%- include('_badge', {stato: r.antivirus}) %></span>
    <span><span class="t"><%= r.codice %></span><br><span class="s"><%= r.hostname || 'nessun hostname' %> · <%= r.azienda %></span></span>
    <span class="chi"><% if (r.assegnato_a) { %><%- include('_avatar', {nome: r.assegnato_a}) %><span class="nome"><%= r.assegnato_a %></span><% } else { %><span class="mut"><%= r.stato %></span><% } %></span>
    <span class="s"><%= r.dispositivo_report ? 'nel report: ' + r.dispositivo_report : 'non trovato nel report' %></span>
    <span class="s n"><%= r.ultimo_rilevato ? 'visto il ' + data(r.ultimo_rilevato) : '' %></span>
  </a>
<% }) %>
</div>
<%- include('_foot') %>
