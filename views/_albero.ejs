<%# albero di navigazione: Dashboard > Azienda > tipologie  + Persone; poi gli strumenti %>
<% const on = (p) => path === p || path.startsWith(p + '/'); %>
<nav class="albero" aria-label="Navigazione">
  <a class="v0 <%= path === '/' ? 'on' : '' %>" href="/"><span>Dashboard</span></a>
  <% (albero || []).forEach((az, i) => { %>
    <div class="grp">
      <a class="v0 az <%= path === '/az/' + az.slug ? 'on' : '' %>" href="/az/<%= az.slug %>"><span class="pt" style="background:var(--c<%= i + 1 %>)"></span><span><%= az.nome %></span><span class="c"><%= az.vivi %></span></a>
      <% az.tipologie.forEach(t => { const b = '/az/' + az.slug + '/' + t.slug; %>
        <a class="v1 <%= (path === b) ? 'on' : '' %>" href="<%= b %>"><%- include('_icon', {tipo: t.nome, dim: 16}) %><span><%= t.nome %></span><span class="c"><%= t.vivi %></span></a>
      <% }) %>
      <a class="v1 <%= on('/az/' + az.slug + '/persone') ? 'on' : '' %>" href="/az/<%= az.slug %>/persone"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 5.2a3 3 0 0 1 0 5.6M21 20c0-2.6-1.6-4.8-4-5.6"/></svg><span>Persone</span><span class="c"><%= az.persone %></span></a>
    </div>
  <% }) %>
  <div class="grp str"><div class="et">Strumenti</div>
    <a class="v1 <%= on('/movimenti') ? 'on' : '' %>" href="/movimenti"><span>Movimenti</span></a>
    <a class="v1 <%= on('/cestino') ? 'on' : '' %>" href="/cestino"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg><span>Cestino</span><span class="c"><%= nCestino %></span></a>
    <a class="v1 <%= on('/importa') ? 'on' : '' %>" href="/importa"><span>Importa</span></a>
    <div class="et" style="margin-top:10px">Elenchi completi</div>
    <a class="v1 <%= path === '/asset' ? 'on' : '' %>" href="/asset"><span>Tutti gli asset</span></a>
    <a class="v1 <%= path === '/persone' ? 'on' : '' %>" href="/persone"><span>Tutte le persone</span></a>
  </div>
</nav>
