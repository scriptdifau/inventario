<%- include('_head', {titolo: p.nome + ' ' + p.cognome}) %>
<p class="mut" style="margin:0 0 8px"><a href="/persone">← Tutte le persone</a></p>
<div class="card"><div class="scheda">
  <%- include('_avatar', {nome: p.nome + ' ' + p.cognome}) %>
  <div style="flex:1;min-width:200px"><h1><%= p.nome %> <%= p.cognome %></h1><div class="mut"><%= p.email || 'nessuna email' %><%= p.azienda ? ' · ' + p.azienda : '' %><%= p.reparto ? ' · ' + p.reparto : '' %></div></div>
  <%- include('_badge', {stato: p.stato}) %><a class="btn" href="/persone/<%= p.id %>/modifica">Modifica</a></div>
  <div class="fatti" style="margin-top:18px">
  <% [['Stato Workspace', p.stato_workspace], ['Ingresso', data(p.data_ingresso)], ['Uscita', data(p.data_uscita)], ['Note', p.note]].forEach(([k, v]) => { if (v) { %><div><span><%= k %></span><b><%= v %></b></div><% } }) %>
  </div></div>
<h2>Asset assegnati <span class="mut">(<%= asset.length %>)</span></h2>
<% if (asset.length) { %><div class="righe" style="margin-bottom:16px"><% asset.forEach(a => { %>
  <a class="riga" style="grid-template-columns:44px minmax(0,1fr) auto" href="/asset/<%= a.id %>"><span class="tondo"><%- include('_icon', {tipo: a.tipologia}) %></span>
    <span><span class="t"><%= [a.marca, a.modello].filter(Boolean).join(' ') || a.tipologia %></span><br><span class="s"><%= a.codice %><%= a.hostname ? ' · ' + a.hostname : '' %></span></span><%- include('_badge', {stato: a.stato}) %></a>
<% }) %></div><% } else { %><div class="card vuoto">Nessun asset assegnato.</div><% } %>
<h2>SIM</h2>
<% if (sim.length) { %><div class="righe"><% sim.forEach(s => { %>
  <div class="riga" style="grid-template-columns:44px minmax(0,1fr) auto"><span class="tondo"><%- include('_icon', {tipo: 'SIM'}) %></span>
    <span><span class="t"><%= s.numero %></span><br><span class="s"><%= s.codice %> · <%= s.operatore %></span></span><%- include('_badge', {stato: s.stato}) %></div>
<% }) %></div><% } else { %><div class="card vuoto">Nessuna SIM.</div><% } %>
<%- include('_foot') %>
