DATABASE_URL=postgres://inv:inv@localhost:5432/inventario
PORT=3000
SESSION_SECRET=cambiami-con-una-stringa-lunga-e-casuale
# Credenziali OAuth "Applicazione web" di Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pubblico dell'app (il redirect è BASE_URL/auth/callback)
BASE_URL=http://localhost:3000
# Domini ammessi (stessa Workspace): valgono per l'email e per il claim hd di Google
ALLOWED_DOMAINS=terre.it,leparolecheservono.it,falacosagiusta.org
# Solo sviluppo: salta il login Google (ignorato se NODE_ENV=production)
# DEV_LOGIN_EMAIL=tuonome@terre.it
# Sincronizzazione Workspace (Directory API): chiave JSON dell'account di servizio (anche in base64) o percorso del file,
# e l'amministratore da impersonare (delega a livello di dominio, scope admin.directory.user.readonly)
# GOOGLE_SA_KEY_FILE=/home/utente/segreti/workspace-sa.json
# WORKSPACE_ADMIN_EMAIL=amministratore@terre.it
# Soglie dell'età dei computer in anni (giallo / rosso); predefiniti 4 e 6
# ETA_ATTENZIONE=4
# ETA_SOSTITUIRE=6
